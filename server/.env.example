# Colyseus server environment variables
# Copy to .env and fill in values (never commit .env)

# Port for the Colyseus WebSocket server
PORT=2567

# Allowed CORS origin (Next.js dev server)
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL connection string (same DB as client)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase project URL and service role key (for JWT verification in onAuth)
# Get from: Supabase Dashboard -> Project Settings -> API
# WARNING: service role key bypasses RLS — never expose to the browser
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
