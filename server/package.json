{
    "name": "@runebound-tactics/server",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --tsconfig ../tsconfig.base.json src/index.ts",
        "clean": "tsc --build --clean",
        "build": "tsc --build",
        "start": "node dist/index.js",
        "test:cards": "yarn ts-node --transpile-only ./src/test-integration/test-cards.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src"
    },
    "dependencies": {
        "@colyseus/schema": "^4.0.0",
        "@colyseus/ws-transport": "^0.17.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@runebound-tactics/shared": "*",
        "@supabase/supabase-js": "^2.105.4",
        "dotenv": "^17.2.3",
        "pg": "^8.20.0",
        "colyseus": "^0.17.0"
    },
    "devDependencies": {
        "@types/pg": "^8.15.6",
        "@colyseus/testing": "^0.17.11",
        "@colyseus/tools": "^0.17.19",
        "@types/node": "^26.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.2",
        "typescript": "^6.0.3"
    }
}
